APP_NAME="Partner Donation Reconciliation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=reconciliation
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production must set SESSION_SECURE_COOKIE=true under HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_PORT=80
FORWARD_DB_PORT=5432
VITE_PORT=5173
WWWUSER=1000
WWWGROUP=1000

RECONCILIATION_MAX_CSV_SIZE_BYTES=1048576
RECONCILIATION_MAX_DATA_ROWS=2000
RECONCILIATION_MAX_COLUMNS=50
RECONCILIATION_MAX_FIELD_LENGTH=4096
RECONCILIATION_MAX_ACTIVE_IMPORTS=3
RECONCILIATION_WORKSPACE_LIFETIME_MINUTES=1440
RECONCILIATION_MAX_PROCESSING_SECONDS=20
RECONCILIATION_OPERATION_LEASE_SECONDS=60
RECONCILIATION_NEW_WORKSPACES_ENABLED=true
RECONCILIATION_WORKSPACE_STARTS_PER_SESSION_PER_MINUTE=5
RECONCILIATION_WORKSPACE_STARTS_PER_IP_PER_MINUTE=5
RECONCILIATION_WORK_PER_SESSION_PER_MINUTE=10
RECONCILIATION_WORK_PER_IP_PER_MINUTE=10
RECONCILIATION_CLEANUP_BATCH_SIZE=100
RECONCILIATION_CLEANUP_LOCK_SECONDS=120
RECONCILIATION_READINESS_SECRET=
CRON_SECRET=
RECONCILIATION_STORAGE_DRIVER=local
RECONCILIATION_IMPORTS_ROOT=reconciliation/imports
RECONCILIATION_EXPORTS_ROOT=reconciliation/exports
RECONCILIATION_ALLOW_ARBITRARY_UPLOADS=false
RECONCILIATION_APPROVED_FIXTURE_CHECKSUMS=
RECONCILIATION_GITHUB_URL="#"
